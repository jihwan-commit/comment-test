{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./src/app/index.css",
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "^@/app/(.*)",
    "^@/pages/(.*)",
    "^@/widgets/(.*)",
    "^@/features/(.*)",
    "^@/entities/(.*)",
    "^@/shared/(.*)",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "trailingComma": "es5",
  "printWidth": 80
}
